# Banco de dados PostgreSQL
# Exemplo Railway: postgresql://user:pass@host:5432/dbname
DATABASE_URL="postgresql://user:password@localhost:5432/financas_bot"

# Chave da API da Anthropic (Claude)
# Obtenha em: https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# Evolution API (WhatsApp)
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="sua-chave-evolution"
EVOLUTION_INSTANCE="meu-bot"  # Nome da instância que você criou

# Porta do servidor (Railway define automaticamente)
PORT=3000
